@host = http://localhost:8000
@adminEmail = admin@taller.local
@adminPassword = Admin123!
@recepcionEmail = recepcion@taller.local
@recepcionPassword = Recepcion123!

### 0. Login recepcion
# @name loginRecepcion
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "{{recepcionEmail}}",
  "password": "{{recepcionPassword}}"
}

### 1. Estados de orden: 200
GET {{host}}/estados-orden

### 2. Apertura de orden: 201
POST {{host}}/ordenes
Content-Type: application/json

{
  "vehiculo_id": 1,
  "falla": "Ruido en motor",
  "items": [
    { "repuesto_id": 1, "cantidad": 1 }
  ]
}

### 3. Apertura con item duplicado: 422
POST {{host}}/ordenes
Content-Type: application/json

{
  "vehiculo_id": 1,
  "falla": "x",
  "items": [
    { "repuesto_id": 1, "cantidad": 1 },
    { "repuesto_id": 1, "cantidad": 2 }
  ]
}

### 4. Listado ordenes: 200
GET {{host}}/ordenes?page=1&size=10

### 5. Listado con estado invalido: 422
GET {{host}}/ordenes?page=1&size=10&estado=NOPE

### 6. Detalle orden: 200
GET {{host}}/ordenes/1

### 7. Detalle inexistente: 404
GET {{host}}/ordenes/999999

### 8. Iniciar orden (requiere mecanico): 200
POST {{host}}/ordenes/1/iniciar

### 9. Terminar orden: 200
POST {{host}}/ordenes/1/terminar

### 10. Cancelar orden: 200
POST {{host}}/ordenes/1/cancelar

### 11. Mis ordenes (rol CLIENTE): 200
GET {{host}}/mis-ordenes?page=1&size=10
EOF